# Optional OpenRouter fallback. Store as a Cloudflare Worker secret.
# It stays disabled unless OPENROUTER_ALLOW_FALLBACK is explicitly set to true.
# OPENROUTER_API_KEY=your-openrouter-key
# OPENROUTER_ALLOW_FALLBACK=true

# Optional model override. Defaults to openrouter/free (chooses an available free model).
# OPENROUTER_MODEL=openrouter/free
