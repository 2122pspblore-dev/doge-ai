# Optional OpenRouter text fallback. Store OPENROUTER_API_KEY as a Cloudflare Worker secret.
# Fallback remains OFF unless OPENROUTER_ALLOW_FALLBACK is explicitly set to "true".
# OPENROUTER_API_KEY=your-openrouter-key
# OPENROUTER_ALLOW_FALLBACK=true

# Optional model override. Defaults to OpenRouter's free-model router.
# OPENROUTER_MODEL=openrouter/free
