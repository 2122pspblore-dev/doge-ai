# Optional OpenRouter fallback. Store as a Cloudflare Worker secret.
# Not needed while the Workers AI free allowance is available.
# OPENROUTER_API_KEY=your-openrouter-key

# Optional model override. Choose a model currently marked free by the provider.
# Defaults to openrouter/free (automatically selects an available free model).
# OPENROUTER_MODEL=openrouter/free
