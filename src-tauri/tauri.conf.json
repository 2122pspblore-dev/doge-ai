{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DOGE AI",
  "version": "1.0.0",
  "identifier": "com.dogeai.desktop",
  "build": {
    "frontendDist": "../desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DOGE AI",
        "width": 1200,
        "height": 800,
        "minWidth": 760,
        "minHeight": 560,
        "center": true
      },
      {
        "label": "vision",
        "title": "DOGE VISION + HANDS",
        "url": "vision.html",
        "width": 540,
        "height": 820,
        "minWidth": 440,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "shortDescription": "DOGE AI desktop assistant",
    "category": "Productivity",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
