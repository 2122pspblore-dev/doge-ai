{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "doge-ai",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-09",
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
