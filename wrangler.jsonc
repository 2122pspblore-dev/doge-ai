{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "doge-ai",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-09",
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "doge-ai-groups",
      "database_id": "ec810728-e3c0-4ebf-aa2e-45ff5e64d748"
    }
  ]
}
